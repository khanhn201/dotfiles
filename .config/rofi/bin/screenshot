#!/usr/bin/env bash
rofi_command="rofi -theme $HOME/.config/rofi/config/screenshot.rasi"

time=`date +%Y%m%d-%I%M%S`
dir="/home/nekoconn/Pictures/Screenshots"
file="${dir}/Screenshot_${time}.png"

screen="󰍹 Capture Desktop"
area="󰆞 Capture Area"
window="󰖲 Capture Window"

geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')

# take shots
shotnow () {
    hyprctl keyword cursor:invisible true
    sleep 0.2
    grim - | tee "$file" | wl-copy --type image/png
    sleep 0.2
    hyprctl keyword cursor:invisible false
}

shotwin () {
    hyprctl keyword cursor:invisible true
    sleep 0.2
    grim -g "$geom" - | tee "$file" | wl-copy --type image/png
    sleep 0.2
    hyprctl keyword cursor:invisible false
}

shotarea () {
    reg="$(slurp -d)"
    if [ -z "$reg" ]; then
        exit 0
    fi
    hyprctl keyword cursor:invisible true
    sleep 0.2
    grim -g "$reg" - | tee "$file" | wl-copy --type image/png
    sleep 0.2
    hyprctl keyword cursor:invisible false
}
# Variable passed to rofi
options="$screen\n$area\n$window"

chosen="$(echo -e "$options" | $rofi_command -p '' -dmenu -selected-row 0)"
case $chosen in
    $screen)
		shotnow
        ;;
    $area)
		shotarea
        ;;
    $window)
		shotwin
		;;
esac

